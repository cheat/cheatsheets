# Print lines appearing in both <file-1> and <file-2>:
comm -12 <(sort file1.csv) <(sort file2.csv)

# Print lines appearing only in the first file (sort both inputs for comm):
comm -23 <(sort file1.csv) <(sort file2.csv)

# Print lines appearing only in the second file:
comm -13 <(sort file1.csv) <(sort file2.csv)

